params {
    pipeline      = 'assembly_polish_qc'  // assembly_polish_qc | autocycler
    long_reads    = null
    read1         = null
    read2         = null
    assembler     = null   // canu | flye  (single-assembler path: assembly_polish_qc)
    tech          = null   // nanopore | nanopore-hq | pacbio
    genome_size   = null   // e.g. 5m, 2.6g  (required for canu; null => Autocycler estimates)
    outdir        = 'results'
    threads       = 1
    racon_iter    = 1
    pilon_iter    = 1
    checkm2_db    = null   // path to uniref100.KO.1.dmnd
    queue         = null   // SLURM partition name (-profile slurm only)
}

conda.enabled = true

process {
    // Retry on common HPC kill signals: OOM (137), timeout (140/143), segfault (139)
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    // Passed to the scheduler; ignored by the local executor
    queue = params.queue

    withLabel: 'assemblers' {
        conda  = "${projectDir}/conda/assemblers.yaml"
        cpus   = { params.threads as int }
        memory = 32.GB
        time   = 24.h
    }

    withLabel: 'qc_tools' {
        conda  = "${projectDir}/conda/qc_tools.yaml"
        cpus   = { params.threads as int }
        memory = 32.GB
        time   = 12.h
    }

    withName: 'ASSEMBLY_CANU' {
        time = 24.h
    }

    withName: 'PILON_POLISH' {
        memory = 28.GB
        time   = 12.h
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = '--nodes=1 --ntasks=1'
    }

    // Wiring-only validation: disables conda so -stub-run works without a conda install
    test {
        conda.enabled = false
    }
}

// Self-contained Autocycler module: owns its params, resources, and conda env.
includeConfig 'modules/vendor/autocycler/nextflow.config'
