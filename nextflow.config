// Self-contained config for the assembly-qc-iden module.
// - Auto-loaded when run standalone:  nextflow run ./assembly-qc-iden ...
// - Pulled into the parent pipeline via `includeConfig` in the repo root config.
//
// Conda environments are declared inline in each process (via ${moduleDir}), so this
// module does not depend on the repo's central conda/ directory or label mappings.

manifest {
    name    = 'assembly-qc-iden'
    version = '0.1.0'   // SemVer; tracks the SOW (Draft v0.1).
}

params {
    // Module-owned params.
    checkm2_db            = params.checkm2_db ?: null        // path to uniref100.KO.1.dmnd (required for CheckM2)
    blast_db              = params.blast_db   ?: null        // formatted nucleotide DB prefix; taxdb.bt* co-located (required for BLAST)
    blast_max_target_seqs = params.blast_max_target_seqs ?: 5
    blast_evalue          = params.blast_evalue ?: '1e-10'
    tech                  = params.tech ?: 'nanopore'        // nanopore | pacbio — picks the QUAST read flag
    reads                 = params.reads     ?: null         // optional long-read FASTQ(.gz) for QUAST read-mapping
    reference             = params.reference ?: null         // optional reference FASTA for QUAST reference-based stats

    // Per-process memory (override per node).
    quast_mem   = params.quast_mem   ?: '8 GB'
    checkm2_mem = params.checkm2_mem ?: '32 GB'
    blast_mem   = params.blast_mem   ?: '16 GB'

    // Shared params — guarded so including this config never clobbers a value the
    // parent (or the CLI) already set, while still providing standalone defaults.
    sample_id = params.sample_id ?: null
    assembly  = params.assembly  ?: null
    threads   = params.threads   ?: 4
    outdir    = params.outdir    ?: 'results'

    // Container images (used by `-profile singularity`; ignored under conda).
    // These are the reproducible distribution — see containers/README.md. For a
    // locked release, replace `:${container_tag}` with `@sha256:<digest>` from the
    // build-containers workflow summary (per-image digests, gold-standard pinning).
    container_registry = params.container_registry ?: 'ghcr.io/minaminii'
    container_tag      = params.container_tag      ?: 'latest'
    // Accumulate (not overwrite) so several modules' maps merge when a parent
    // pipeline includeConfig's all of them; an explicit params.images still wins.
    images = [
        checkm2: "docker://${params.container_registry ?: 'ghcr.io/minaminii'}/bioinf-checkm2:${params.container_tag ?: 'latest'}",
        blast:   "docker://${params.container_registry ?: 'ghcr.io/minaminii'}/bioinf-blast:${params.container_tag ?: 'latest'}",
        quast:   "docker://${params.container_registry ?: 'ghcr.io/minaminii'}/bioinf-quast:${params.container_tag ?: 'latest'}",
    ] + (params.images ?: [:])
    // DB paths (--checkm2_db, --blast_db) are absolute paths used *inside* the
    // script, not Nextflow `path` inputs, so autoMounts won't bind them. Derive the
    // bind from whatever DB paths the client passes — no host-specific assumptions.
    // Override with --singularity_binds '-B /your/db/root' (e.g. if a DB dir holds
    // symlinks pointing outside itself).
    singularity_binds = params.singularity_binds ?: (
        [params.checkm2_db, params.blast_db]
            .findAll { p -> p }
            .collect { p -> new File(p.toString()).parent }
            .findAll { dir -> dir }
            .unique()
            .collect { dir -> "-B ${dir}" }
            .join(' ')
    )
}

// Needed for standalone runs; harmless when the parent already enables it.
conda.enabled = true

process {
    withLabel: 'quast' {
        cpus   = { params.threads as int }
        memory = { params.quast_mem }
        time   = 4.h
    }
    withLabel: 'checkm2' {
        cpus   = { params.threads as int }
        memory = { params.checkm2_mem }
        time   = 12.h
    }
    withLabel: 'blast' {
        cpus   = { params.threads as int }
        memory = { params.blast_mem }
        time   = 24.h   // megablast vs core_nt is the long pole
    }
}

profiles {
    // Resolve the inline conda envs with micromamba instead of conda/mamba.
    micromamba {
        conda.enabled       = true
        conda.useMicromamba = true
    }

    // Run the frozen container images instead of solving conda envs. Each process
    // carries both a `conda` and a `container` directive; enabling Singularity here
    // makes Nextflow pick the container. Non-breaking for the conda profiles above.
    singularity {
        conda.enabled          = false
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${System.getProperty('user.home')}/.singularity/cache"
        singularity.runOptions = params.singularity_binds
    }

    // Wiring-only validation: disable conda so -stub-run works without a conda install.
    // Stubs touch empty files and load no DBs, so drop the memory requests to keep the
    // check runnable on small dev nodes (production sizes are the defaults above).
    test {
        conda.enabled = false
        process {
            withLabel: 'quast'   { memory = 1.GB }
            withLabel: 'checkm2' { memory = 1.GB }
            withLabel: 'blast'   { memory = 1.GB }
        }
    }
}
