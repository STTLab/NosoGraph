params {
    pipeline      = 'bacterial-assembly'  // bacterial-assembly | autocycler | metagenomics
    sample_id     = null   // required: scopes outputs to <outdir>/<sample_id>/ and namespaces contig IDs
    long_reads    = null
    read1         = null
    read2         = null
    genome_size   = null   // e.g. 5m, 2.6g  (required for canu; null => Autocycler estimates)
    outdir        = 'results'
    threads       = 1
    queue         = null   // SLURM partition name (-profile slurm only)
    // Pipeline-specific params (assembler, tech, racon_iter, pilon_iter, checkm2_db, ...)
    // are owned by each vendored module's own nextflow.config (included below).

    // NosoGraph-owned metagenomics exporter (report/meta_kg_export.py) tuning. Not part of
    // the vendored kraken2-classify module: they shape the taxa_json QC blob's "Other" bucket.
    kraken2_z_min    = -1.0   // z-score cutoff; taxa below fold into an "Other" bucket
    kraken2_min_taxa = 3      // keep all taxa (no bucketing) when fewer than this many

    // Execution engine: 'singularity' (default, reproducible containers) | 'conda' |
    // 'none' (stub only). Selected via profiles, never on the CLI directly — the engine
    // is actually toggled by the post-include block at the bottom of this file (it has to
    // run after the modules re-assert their standalone `conda.enabled = true`). Profiles:
    //   (default)/standard/slurm -> singularity   micromamba -> conda   test -> none
    engine = 'singularity'

    // Container distribution (the default, reproducible execution path). Every vendored
    // module pulls its image from <container_registry>/bioinf-<tool>:<container_tag>;
    // override the registry/tag once here and all modules follow. For a locked release,
    // pin container_tag to an immutable digest (see each module's containers/README.md).
    container_registry = 'ghcr.io/minaminii'
    container_tag      = 'latest'
    // NB: the NosoGraph-owned exporters (KG_EXPORT / META_KG_EXPORT) declare no container
    // and run on the host Python (pandas); only the vendored bioinformatics tools are
    // containerised. Each vendored module owns its own `images` map, so none is set here.
}

process {
    // Retry on common HPC kill signals: OOM (137), timeout (140/143), segfault (139)
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    // Passed to the scheduler; ignored by the local executor
    queue = params.queue
}

profiles {
    // Profiles only pick the executor and the engine (via params.engine); the engine is
    // actually switched on in the post-include block below. See the note on params.engine.
    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = '--nodes=1 --ntasks=1'
    }

    // Opt back into conda (resolved with micromamba) instead of the container images.
    // Unreliable conda releases are why containers are the default — use this only when
    // a container runtime is unavailable. Mirrors each vendored module's `micromamba` profile.
    micromamba {
        params.engine       = 'conda'
        conda.useMicromamba = true
    }

    // Explicit container path (same as the default). Kept so `-profile singularity` is a
    // valid, self-documenting choice and merges with each vendored module's own profile.
    singularity {
        params.engine = 'singularity'
    }

    // Wiring-only validation: disable both engines so -stub-run works with neither a
    // conda install nor a container runtime.
    test {
        params.engine = 'none'
    }
}

// Self-contained vendored modules: each owns its params, resources, conda env, and
// container image. Loaded before the engine switch below so that switch wins over the
// `conda.enabled = true` each module re-asserts for standalone use.
includeConfig 'modules/vendor/autocycler/nextflow.config'
includeConfig 'modules/vendor/bacterial-assembly/nextflow.config'
includeConfig 'modules/vendor/kraken2-classify/nextflow.config'
includeConfig 'modules/vendor/assembly-qc-iden/nextflow.config'

// Engine switch — must be the LAST word on conda/singularity so it overrides the
// modules' standalone `conda.enabled = true` (re-asserted at include time above). Every
// vendored process carries both a `conda` and a `container` directive; toggling these two
// flags decides which one Nextflow uses. Driven by params.engine so profiles can steer it.
conda.enabled          = ( params.engine == 'conda' )
singularity.enabled    = ( params.engine == 'singularity' )
singularity.autoMounts = true
singularity.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${System.getProperty('user.home')}/.singularity/cache"
singularity.runOptions = params.singularity_binds ?: ''
