// SPDX-License-Identifier: MPL-2.0
//
// Autocycler with canu added to the default stack, for better small-plasmid
// recovery. canu is much slower and hungrier than the others, so it gets more
// memory and time while the fast assemblers keep modest limits.
//
// Usage:
//   ./nosograph assembly autocycler -profile micromamba -c autocycler-canu-stack.config \
//       --sample_id BAC_S001 --long_reads /data/reads/BAC_S001.fastq.gz \
//       --outdir results/BAC_S001
//
// 4 assemblers x 4 subsamples = 16 assembly jobs.

params {
    pipeline        = 'autocycler'
    genome_size     = '5.5m'                // canu needs a genome size
    assemblers      = 'flye,miniasm,raven,canu'
    subsample_count = 4
    threads         = 16
}

process {
    // `assembler` is the AUTOCYCLER_ASSEMBLE input, so limits can depend on it.
    withName: 'AUTOCYCLER_ASSEMBLE' {
        memory = { assembler == 'canu' ? 48.GB : 16.GB }
        time   = { assembler == 'canu' ? 48.h  : 12.h  }
    }
}
