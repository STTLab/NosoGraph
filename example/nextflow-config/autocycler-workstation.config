// SPDX-License-Identifier: MPL-2.0
//
// Autocycler on a single workstation or server (local executor).
//
// Usage:
//   nextflow run main.nf -profile micromamba -c autocycler-workstation.config \
//       --long_reads /data/reads/BAC_S001.fastq.gz --outdir results/BAC_S001
//
// Pick the engine on the command line with -profile (micromamba or singularity);
// setting params.engine in this file has no effect.

params {
    pipeline        = 'autocycler'
    genome_size     = '5.5m'                // drop to let Autocycler estimate it
    assemblers      = 'flye,miniasm,raven'
    subsample_count = 4
    threads         = 8                     // per job; NosoGraph's default is 1
}

// Cap what the whole run may use at once. Jobs beyond this wait in a queue.
// With 32 CPUs and threads = 8, four assembly jobs run side by side.
executor {
    cpus   = 32
    memory = '96 GB'
}

process {
    // Defaults are 32 GB / 24 h per assembly job; bacterial genomes rarely need that.
    withLabel: 'autocycler_assembly' {
        memory = 16.GB
        time   = 12.h
    }
}
