// SPDX-License-Identifier: MPL-2.0
//
// Run Autocycler from a conda env you built once and froze, so nothing is solved
// or downloaded at run time. Handy on machines with limited bandwidth.
//
// One-time setup (after any successful -profile micromamba run):
//   micromamba env export --explicit -p work/conda/autocycler-<hash> > autocycler.lock
//   micromamba create --offline -p $HOME/envs/autocycler -f autocycler.lock
//   chmod -R a-w $HOME/envs/autocycler            # guard against accidental changes
//
// Usage:
//   ./nosograph assembly autocycler -profile micromamba -c autocycler-frozen-conda-env.config \
//       --sample_id BAC_S001 --long_reads /data/reads/BAC_S001.fastq.gz \
//       --outdir results

params {
    pipeline = 'autocycler'
    threads  = 8
}

process {
    // A directory path makes Nextflow use that env as-is.
    withLabel: 'autocycler'          { conda = "${System.getenv('HOME')}/envs/autocycler" }
    withLabel: 'autocycler_assembly' { conda = "${System.getenv('HOME')}/envs/autocycler" }
}
