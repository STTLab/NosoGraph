// SPDX-License-Identifier: MPL-2.0
//
// Run Autocycler from an exact container image instead of the moving `latest` tag.
// Use ONE of the two options below.
//
// Usage:
//   nextflow run main.nf -profile singularity -c autocycler-pinned-image.config \
//       --sample_id BAC_S001 --long_reads /data/reads/BAC_S001.fastq.gz \
//       --outdir results/BAC_S001

params {
    pipeline = 'autocycler'
    threads  = 8

    // Option A: pin the registry image by digest. Find the current one with
    //   docker buildx imagetools inspect ghcr.io/minaminii/bioinf-autocycler:latest
    images = [autocycler: 'docker://ghcr.io/minaminii/bioinf-autocycler@sha256:<digest>']

    // Option B: a .sif file you built or copied onto this machine (no download).
    // images = [autocycler: '/data/containers/bioinf-autocycler.sif']
}
