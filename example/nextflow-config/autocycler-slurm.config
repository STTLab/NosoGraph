// SPDX-License-Identifier: MPL-2.0
//
// Autocycler on a SLURM cluster: every assembly job is its own SLURM job.
//
// Usage:
//   nextflow run main.nf -profile slurm,singularity -c autocycler-slurm.config \
//       --sample_id BAC_S001 --long_reads /project/reads/BAC_S001.fastq.gz \
//       --outdir /project/results/BAC_S001
//
// For conda instead of containers, use -profile slurm,micromamba.

params {
    pipeline        = 'autocycler'
    genome_size     = '5.5m'
    assemblers      = 'flye,miniasm,raven'
    subsample_count = 4
    threads         = 16
}

executor {
    queueSize       = 20                    // max jobs in the SLURM queue at once
    submitRateLimit = '10/1min'             // be polite to the scheduler
}

process {
    // Your SLURM partition. Set it here (or pass --queue on the command line):
    // `params.queue` in a -c file is read too late to reach the jobs.
    queue = 'compute'

    withLabel: 'autocycler_assembly' {
        memory = 32.GB
        time   = 24.h
    }
    withLabel: 'autocycler' {
        memory = 16.GB
        time   = 4.h
    }
}

// Pull each image once into a shared, persistent location that compute nodes can
// read. Compute nodes without internet need the image here before the run starts.
singularity.cacheDir = '/project/shared/singularity-cache'
