#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
#
# nosograph — thin command-line wrapper around `nextflow run` for this repository.
# It only picks the right --pipeline / --assembler(s) from a short subcommand; every
# other option goes to Nextflow unchanged.
#
#   nosograph assembly flye      --sample_id S01 --long_reads reads.fq.gz ...
#   nosograph assembly autocycler,canu,flye --sample_id S01 --long_reads reads.fq.gz ...
#   nosograph kraken2-classify   --sample_id S01 --long_reads reads.fq.gz ...
#
# Installation defaults (e.g. database paths) can go in a .env file next to this script;
# see .env.example. Set NEXTFLOW to use a specific nextflow binary (default: `nextflow`
# on PATH) and NOSOGRAPH_ENV to read a different defaults file.

set -euo pipefail

# Resolve the repo directory even when this script is reached through a symlink
# (e.g. ~/.local/bin/nosograph -> <repo>/nosograph).
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
PROJECT_DIR="$(cd -P "$(dirname "$src")" && pwd)"
NEXTFLOW="${NEXTFLOW:-nextflow}"
ENV_FILE="${NOSOGRAPH_ENV:-$PROJECT_DIR/.env}"

BACTERIAL_ASSEMBLERS="canu flye unicycler"
# Parameters the subcommands set themselves; refused on the command line and in .env.
ROUTING_PARAMS="pipeline assembler assemblers"

usage() {
    cat <<'EOF'
Usage: nosograph <command> [arguments]

Commands:
  assembly <assembler>   Assemble one sample (see `nosograph assembly --help`)
  kraken2-classify       Estimate read identity and screen for contaminants with Kraken2
                         (see `nosograph kraken2-classify --help`)

Options:
  -h, --help             Show this help

Any other options are passed straight to `nextflow run`, e.g. -profile, -resume,
-c my.config, --sample_id, --long_reads, --outdir, --threads.

Installation defaults such as database paths can be set in a .env file next to the
nosograph script (see .env.example); options on the command line override them.
EOF
}

usage_assembly() {
    cat <<'EOF'
Usage: nosograph assembly <assembler> [options for nextflow run]

<assembler> picks the pipeline:
  canu | flye | unicycler   single assembler   -> --pipeline bacterial-assembly --assembler <it>
  autocycler                consensus, default stack (flye,miniasm,raven)
                                               -> --pipeline autocycler
  autocycler,<a>,<b>,...    consensus with your own stack
                                               -> --pipeline autocycler --assemblers <a>,<b>,...

Wrapper options:
  --dry-run    Print the nextflow command instead of running it
  -h, --help   Show this help

Everything else goes to `nextflow run` unchanged. Nextflow's own options take ONE dash
(-profile, -resume, -c); pipeline parameters take TWO (--sample_id, --outdir).
Defaults from .env (e.g. checkm2_db, blast_db) are added unless you pass them; use
e.g. --checkm2_db false to skip a database for one run.

Each run writes to <outdir>/<sample_id>/assembly/<run_name>/, where --run_name defaults
to the assembler, so several assemblers can run on one sample into the same --outdir.
Set --run_name to keep two runs of the same assembler.

Examples:
  nosograph assembly flye -profile micromamba \
      --sample_id S01 --long_reads reads.fastq.gz --outdir results --threads 16
  nosograph assembly unicycler -profile micromamba \
      --sample_id S02 --long_reads long.fq.gz --read1 R1.fq.gz --read2 R2.fq.gz
  nosograph assembly autocycler,canu,flye -profile micromamba -resume \
      --sample_id S03 --long_reads reads.fastq.gz --outdir results --threads 24
  nosograph assembly autocycler,canu,raven --run_name autocycler_canu -profile micromamba \
      --sample_id S03 --long_reads reads.fastq.gz --outdir results --threads 24
EOF
}

usage_kraken2_classify() {
    cat <<'EOF'
Usage: nosograph kraken2-classify [options for nextflow run]

Classifies one sample's long reads against a Kraken2 database to estimate what the
reads are and to screen for contaminants      -> --pipeline kraken2-classify

Wrapper options:
  --dry-run    Print the nextflow command instead of running it
  -h, --help   Show this help

Everything else goes to `nextflow run` unchanged. Needs --sample_id, --long_reads and
--kraken2_db (or kraken2_db in .env).

Example:
  nosograph kraken2-classify -profile micromamba \
      --sample_id S01 --long_reads reads.fastq.gz --kraken2_db /data/k2_standard --outdir results
EOF
}

die() {
    echo "nosograph: $*" >&2
    exit 2
}

is_bacterial_assembler() {
    case " $BACTERIAL_ASSEMBLERS " in *" $1 "*) return 0 ;; esac
    return 1
}

is_routing_param() {
    case " $ROUTING_PARAMS " in *" $1 "*) return 0 ;; esac
    return 1
}

# Read KEY=VALUE lines from $ENV_FILE into env_keys / env_vals. The file is parsed, never
# sourced: blank lines and # comments are skipped, an optional `export ` prefix and one
# pair of surrounding quotes are dropped, and anything else is an error.
env_keys=()
env_vals=()
load_env() {
    [ -f "$ENV_FILE" ] || return 0
    local line key val n=0
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        line="${line%$'\r'}"
        # Trim surrounding whitespace.
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        case "$line" in ''|'#'*) continue ;; esac
        line="${line#export }"
        case "$line" in
            *=*) ;;
            *) die "$ENV_FILE:$n: expected key=value, got '$line'" ;;
        esac
        key="${line%%=*}"
        val="${line#*=}"
        key="${key%"${key##*[![:space:]]}"}"
        val="${val#"${val%%[![:space:]]*}"}"
        case "$key" in
            ''|[0-9]*|*[!A-Za-z0-9_]*) die "$ENV_FILE:$n: '$key' is not a parameter name" ;;
        esac
        if is_routing_param "$key"; then
            die "$ENV_FILE:$n: '$key' is set by the nosograph subcommand, not .env"
        fi
        case "$val" in
            \"*\") val="${val#\"}"; val="${val%\"}" ;;
            \'*\') val="${val#\'}"; val="${val%\'}" ;;
        esac
        env_keys+=("$key")
        env_vals+=("$val")
    done < "$ENV_FILE"
}

# Run nextflow with the given routing params. Remaining args are the user's options:
# --dry-run and -h/--help are handled here, routing params are refused, and .env
# defaults are appended for every parameter the user did not pass.
run_pipeline() {
    local usage_fn="$1" what="$2"
    shift 2
    local route=()
    while [ $# -gt 0 ] && [ "$1" != "--" ]; do
        route+=("$1")
        shift
    done
    [ $# -gt 0 ] && shift   # drop the "--" separator

    local passthrough=() dry_run=0 arg name
    for arg in "$@"; do
        case "$arg" in
            --dry-run) dry_run=1 ;;
            -h|--help) "$usage_fn"; exit 0 ;;
            --*)
                name="${arg#--}"
                name="${name%%=*}"
                if is_routing_param "$name"; then
                    die "don't pass --$name; it is set from '$what'"
                fi
                passthrough+=("$arg")
                ;;
            *) passthrough+=("$arg") ;;
        esac
    done

    load_env
    # For each .env key: the user's own --key wins. `--key false` (or --key=false) turns
    # the default off for this run; Nextflow would read "false" as a set value, so that
    # pair is dropped too. drop[] marks passthrough positions to leave out.
    local defaults=() drop=() off=() i=0 j n="${#passthrough[@]}" key given
    while [ "$i" -lt "${#env_keys[@]}" ]; do   # index loops: bash 3.2 + set -u vs empty arrays
        key="${env_keys[$i]}"
        given=0
        j=0
        while [ "$j" -lt "$n" ]; do
            case "${passthrough[$j]}" in
                "--$key=false")
                    given=1; drop[j]=1 ;;
                "--$key")
                    given=1
                    if [ $((j + 1)) -lt "$n" ] && [ "${passthrough[$((j + 1))]}" = "false" ]; then
                        drop[j]=1; drop[j + 1]=1
                    fi ;;
                "--$key="*)
                    given=1 ;;
            esac
            j=$((j + 1))
        done
        [ "$given" -eq 1 ] || defaults+=("--$key" "${env_vals[$i]}")
        i=$((i + 1))
    done
    if [ "${#drop[@]}" -gt 0 ]; then
        local kept=()
        j=0
        while [ "$j" -lt "$n" ]; do
            if [ "${drop[$j]:-}" = 1 ]; then
                case "${passthrough[$j]}" in --*) off+=("${passthrough[$j]%%=*}") ;; esac
            else
                kept+=("${passthrough[$j]}")
            fi
            j=$((j + 1))
        done
        passthrough=()
        [ "${#kept[@]}" -eq 0 ] || passthrough=("${kept[@]}")
    fi
    if [ "${#defaults[@]}" -gt 0 ]; then
        echo "nosograph: defaults from $ENV_FILE: ${defaults[*]}" >&2
    fi
    if [ "${#off[@]}" -gt 0 ]; then
        echo "nosograph: turned off for this run: ${off[*]}" >&2
    fi

    local cmd=("$NEXTFLOW" run "$PROJECT_DIR" "${route[@]}")
    [ "${#passthrough[@]}" -eq 0 ] || cmd+=("${passthrough[@]}")
    [ "${#defaults[@]}" -eq 0 ] || cmd+=("${defaults[@]}")

    if [ "$dry_run" -eq 1 ]; then
        printf '%q ' "${cmd[@]}"
        echo
        exit 0
    fi
    exec "${cmd[@]}"
}

cmd_assembly() {
    if [ $# -eq 0 ]; then
        usage_assembly >&2
        exit 2
    fi
    case "$1" in
        -h|--help) usage_assembly; exit 0 ;;
        -*) die "assembly: the assembler must come first, e.g. 'nosograph assembly flye ...' (got '$1')" ;;
    esac

    local choice="$1"
    shift

    # Split "autocycler,canu,flye" into its parts.
    local parts=()
    IFS=',' read -r -a parts <<< "$choice"
    [ "${#parts[@]}" -gt 0 ] || die "assembly: empty assembler name"

    local route=()
    if [ "${parts[0]}" = "autocycler" ]; then
        route=(--pipeline autocycler)
        if [ "${#parts[@]}" -gt 1 ]; then
            local stack="" a
            for a in "${parts[@]:1}"; do
                [ -n "$a" ] || die "assembly: empty assembler name in '$choice'"
                [ "$a" != "autocycler" ] || die "assembly: 'autocycler' can only appear first in '$choice'"
                stack="${stack:+$stack,}$a"
            done
            route+=(--assemblers "$stack")
        fi
    elif [ "${#parts[@]}" -gt 1 ]; then
        die "assembly: several assemblers need Autocycler first, e.g. 'nosograph assembly autocycler,$choice'"
    elif is_bacterial_assembler "$choice"; then
        route=(--pipeline bacterial-assembly --assembler "$choice")
    else
        die "assembly: unknown assembler '$choice'. Use canu, flye, unicycler, or autocycler[,<assemblers>]"
    fi

    run_pipeline usage_assembly "assembly $choice" "${route[@]}" -- "$@"
}

cmd_kraken2_classify() {
    run_pipeline usage_kraken2_classify "kraken2-classify" --pipeline kraken2-classify -- "$@"
}

[ $# -gt 0 ] || { usage >&2; exit 2; }
command="$1"
shift
case "$command" in
    assembly)         cmd_assembly "$@" ;;
    kraken2-classify) cmd_kraken2_classify "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command '$command'. Run 'nosograph --help'." ;;
esac
