// SPDX-License-Identifier: MPL-2.0
//
// Scope every published output to <outdir>/<sample_id>/ (one sample per run).
//
// The vendored modules publish straight to ${params.outdir}/<subdir>, and they are not
// edited here. A withName rule in config replaces the process's own publishDir, so each
// rule below re-points one vendored process at the same <subdir> under <sample_id>/.
// The KG exporters (modules/local/) already publish under <sample_id>/ and need no rule.
//
// Keep in step with the vendored modules: after a vendor bump, check
//   grep -rn publishDir modules/vendor
// A process that has no rule here publishes to the old, unscoped location.
// TODO: replace with sample-scoped publishing upstream in bioinformatics-workflows.

process {
    // assembly-qc-iden (QUAST, CheckM2, BLAST) and bacterial-assembly's own CheckM2
    withName: 'QUAST|CHECKM2|BLAST' {
        publishDir = [path: { "${params.outdir}/${params.sample_id}" }, mode: 'copy']
    }

    // bacterial-assembly
    withName: 'ASSEMBLY_FLYE|ASSEMBLY_CANU|ASSEMBLY_UNICYCLER' {
        publishDir = [path: { "${params.outdir}/${params.sample_id}/01_assembly" }, mode: 'copy']
    }
    withName: 'RACON_POLISH' {
        publishDir = [path: { "${params.outdir}/${params.sample_id}/02_polish/01_racon" }, mode: 'copy']
    }
    withName: 'PILON_POLISH' {
        publishDir = [path: { "${params.outdir}/${params.sample_id}/02_polish/02_pilon" }, mode: 'copy']
    }

    // autocycler
    withName: 'AUTOCYCLER_SUBSAMPLE' {
        publishDir = [path: { "${params.outdir}/${params.sample_id}/01_assembly/subsampled_reads" }, mode: 'copy']
    }
    withName: 'AUTOCYCLER_ASSEMBLE' {
        publishDir = [path: { "${params.outdir}/${params.sample_id}/01_assembly/assemblies" }, mode: 'copy']
    }
    withName: 'AUTOCYCLER_COMBINE' {
        publishDir = [path: { "${params.outdir}/${params.sample_id}/01_assembly" }, mode: 'copy']
    }

    // kraken2-classify
    withName: 'KRAKEN2' {
        publishDir = [path: { "${params.outdir}/${params.sample_id}/kraken2" }, mode: 'copy']
    }
}
