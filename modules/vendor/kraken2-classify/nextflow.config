// Self-contained config for the kraken2-classify module.
// - Auto-loaded when run standalone:  nextflow run ./kraken2-classify ...
// - Pulled into the parent pipeline via `includeConfig` in the repo root config.
//
// Conda environments are declared inline in each process (via ${moduleDir}), so this
// module does not depend on the repo's central conda/ directory or label mappings.

params {
    // Module-owned params.
    kraken2_db         = params.kraken2_db ?: null      // DB dir with hash.k2d/opts.k2d/taxo.k2d (required)
    kraken2_confidence = params.kraken2_confidence ?: 0 // kraken2 --confidence (0 = kraken2 default)
    kraken2_mem        = params.kraken2_mem ?: '64 GB'  // RAM ~= DB size; raise for the full Standard DB

    // Shared params — guarded so including this config never clobbers a value the
    // parent (or the CLI) already set, while still providing standalone defaults.
    sample_id  = params.sample_id  ?: null
    long_reads = params.long_reads ?: null
    threads    = params.threads    ?: 4
    outdir     = params.outdir     ?: 'results'
}

// Needed for standalone runs; harmless when the parent already enables it.
conda.enabled = true

process {
    withLabel: 'kraken2' {
        cpus   = { params.threads as int }
        memory = { params.kraken2_mem }
        time   = 8.h
    }
}

profiles {
    // Resolve the inline conda env with micromamba instead of conda/mamba.
    micromamba {
        conda.enabled       = true
        conda.useMicromamba = true
    }

    // Wiring-only validation: disable conda so -stub-run works without a conda install.
    // The stub touches empty files and never loads the DB, so drop the memory request
    // to keep the check runnable on small dev nodes (the 64 GB default is production-only).
    test {
        conda.enabled = false
        process {
            withLabel: 'kraken2' { memory = 1.GB }
        }
    }
}
