# SPDX-License-Identifier: MPL-2.0
#
# Installation defaults for the `nosograph` command. Copy this file to `.env` in the same
# directory as the `nosograph` script (e.g. /opt/NosoGraph/.env) and uncomment what you
# need. `.env` is gitignored, so machine-specific paths never end up in the repository.
#
# Each line is `<parameter>=<value>`, using the pipeline's parameter names without the
# leading `--`. nosograph adds them as `--<parameter> <value>` to every run, unless the
# command line already sets that parameter. `--<parameter> false` turns one off for a run,
# e.g. `nosograph assembly flye --blast_db false ...` skips BLAST.
#
# One exception: `profile` sets Nextflow's `-profile` (one dash) instead of a parameter. A
# -profile on the command line replaces it for that run.
#
# The file is read, not executed: only key=value lines and # comments are allowed.
# `--pipeline`, `--assembler` and `--assemblers` are set by the subcommand and can't go here.
# Plain `nextflow run main.nf ...` does not read this file.

# Nextflow profile(s), comma-separated, e.g. micromamba, slurm, or slurm,micromamba.
# Without it Nextflow uses the default (local executor, Singularity containers).
#profile=slurm

# CheckM2 database (uniref100.KO.1.dmnd). When set, CheckM2 runs on every assembly.
#checkm2_db=/data/checkm2_db/CheckM2_database/uniref100.KO.1.dmnd

# BLAST nucleotide database prefix. When set, assemblies get per-contig identification
# (and single-assembler runs also get QUAST).
#blast_db=/data/blast/nt

# Kraken2 database directory (hash.k2d, opts.k2d, taxo.k2d), for `nosograph kraken2-classify`.
#kraken2_db=/data/k2_standard

# Threads per job. NosoGraph's own default is 1.
#threads=16
